{
  "name": "@montaj/worker-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Python 3.12 BullMQ worker (thin pnpm/turbo wrapper around the .venv).",
  "license": "UNLICENSED",
  "scripts": {
    "setup": "node scripts/py.mjs --setup-only",
    "dev": "node scripts/py.mjs -m worker_ai",
    "start": "node scripts/py.mjs -m worker_ai",
    "eval": "node scripts/py.mjs -m worker_ai.evals nightly",
    "lint": "node scripts/py.mjs -m ruff check .",
    "format": "node scripts/py.mjs -m ruff format .",
    "typecheck": "node scripts/py.mjs -m mypy --strict .",
    "test": "node scripts/py.mjs -m pytest -q",
    "lock": "node scripts/py.mjs -m piptools compile --extra dev --strip-extras --output-file requirements-dev.lock pyproject.toml",
    "clean": "node -e \"require('node:fs').rmSync('.venv',{recursive:true,force:true})\""
  }
}
