{
  "provider": "sarvam",
  "baseUrl": "https://api.sarvam.test",
  "exchanges": [
    {
      "method": "POST",
      "path": "/speech-to-text/job/v1",
      "status": 202,
      "json": {
        "job_id": "job-2",
        "storage_container_type": "Azure_V1",
        "job_state": "Accepted"
      }
    },
    {
      "method": "POST",
      "path": "/upload-files",
      "status": 200,
      "json": {
        "job_id": "job-2",
        "job_state": "Accepted",
        "upload_urls": {
          "chunk-0000.wav": {
            "file_url": "https://sarvamblob.test/job-2/chunk-0000.wav?sv=2026-01-01&sig=replay"
          }
        }
      }
    },
    {
      "method": "PUT",
      "path": "sarvamblob.test/job-2/",
      "status": 201,
      "text": ""
    },
    {
      "method": "POST",
      "path": "/start",
      "status": 200,
      "json": {
        "job_id": "job-2",
        "job_state": "Running"
      }
    },
    {
      "method": "GET",
      "path": "/status",
      "status": 200,
      "json": {
        "job_id": "job-2",
        "job_state": "Failed",
        "error_message": "audio could not be decoded"
      }
    }
  ]
}
