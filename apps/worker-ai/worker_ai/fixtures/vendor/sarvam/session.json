{
  "provider": "sarvam",
  "baseUrl": "https://api.sarvam.test",
  "exchanges": [
    {
      "method": "POST",
      "path": "/speech-to-text/job/v1",
      "status": 202,
      "json": {
        "job_id": "job-1",
        "storage_container_type": "Azure_V1",
        "job_state": "Accepted"
      }
    },
    {
      "method": "POST",
      "path": "/upload-files",
      "status": 200,
      "json": {
        "job_id": "job-1",
        "job_state": "Accepted",
        "upload_urls": {
          "chunk-0000.wav": {
            "file_url": "https://sarvamblob.test/job-1/chunk-0000.wav?sv=2026-01-01&sig=replay"
          }
        }
      }
    },
    {
      "method": "PUT",
      "path": "sarvamblob.test/job-1/",
      "status": 201,
      "text": ""
    },
    {
      "method": "POST",
      "path": "/start",
      "status": 200,
      "json": {
        "job_id": "job-1",
        "job_state": "Running"
      }
    },
    {
      "method": "GET",
      "path": "/status",
      "status": 200,
      "json": {
        "job_id": "job-1",
        "job_state": "Running"
      }
    },
    {
      "method": "GET",
      "path": "/status",
      "status": 200,
      "json": {
        "job_id": "job-1",
        "job_state": "Completed",
        "job_details": [
          {
            "inputs": [{ "file_name": "chunk-0000.wav", "file_id": "f-in-1" }],
            "outputs": [{ "file_name": "chunk-0000.json", "file_id": "f-out-1" }],
            "state": "Success",
            "error_message": null,
            "exception_name": null
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/download-files",
      "status": 200,
      "json": {
        "job_id": "job-1",
        "job_state": "Completed",
        "download_urls": {
          "chunk-0000.json": {
            "file_url": "https://sarvamblob.test/job-1-out/chunk-0000.json?sv=2026-01-01&sig=replay"
          }
        }
      }
    },
    {
      "method": "GET",
      "path": "sarvamblob.test/job-1-out/",
      "status": 200,
      "json": {
        "language_code": "hi-IN",
        "language_probability": 0.94,
        "transcript": "toh aaj hum baat karenge video editing ke baare mein",
        "timestamps": {
          "chunks": [
            {
              "text": "toh aaj hum baat karenge",
              "start_time_seconds": 0.12,
              "end_time_seconds": 2.1
            },
            {
              "text": "video editing ke baare mein",
              "start_time_seconds": 2.2,
              "end_time_seconds": 3.98
            }
          ]
        }
      }
    }
  ]
}
