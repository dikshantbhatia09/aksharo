{
  "name": "@montaj/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Node SEA wrapper around @montaj/bridge-core: the local bridge process users install to talk to Premiere/AE/Resolve panels.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build:sea": "node scripts/build-sea.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@montaj/bridge-core": "workspace:*",
    "@montaj/config": "workspace:*",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
