    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "assets:render": "node scripts/copy-render-assets.mjs"
  },
