    "@montaj/config": "workspace:*",
    "@montaj/edg": "workspace:*",
    "@montaj/fonts": "workspace:*",
    "@montaj/render-canvaskit": "workspace:*",
    "@montaj/render-core": "workspace:*",
    "@montaj/render-manifest": "workspace:*",
    "@montaj/timemap": "workspace:*",
    "@montaj/ui": "workspace:^",
    "@sentry/browser": "^10.73.0",
