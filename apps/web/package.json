{
  "name": "@montaj/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 15 App Router: marketing site and studio (route groups site, app, share, admin).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
