// Prisma schema for the Montaj (codename) / Aksharo API.
//
// Source of truth: `03-architecture/06-data-model.md` (v2). Every table in that
// document exists here; deviations are listed in the A03 report and must carry an
// ADR before they change. Conventions (docs/CONTRACTS.md §0):
//
//   * ids        ULID strings, `@id @db.Char(26)`
//   * times      `timestamptz` (`@db.Timestamptz(6)`), never `timestamp`
//   * money      integer MINOR units (paise / cents) + an ISO currency column
//   * credits    integer TENTHS of a credit (`*Tenths`)
//   * media time milliseconds (`*Ms`)
//   * JSONB      `Json @db.JsonB`; every such column names its Zod schema in a comment
//   * columns    snake_case in the database, camelCase in the client (`@map`)
//
// Anything Prisma cannot express lives in `prisma/sql/` and is applied by
// `pnpm db:migrate` after `prisma migrate deploy`. Those objects are invisible to
// `prisma db pull`, so each one is also recorded as a comment on the model it
// belongs to — see `prisma/sql/README.md`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

