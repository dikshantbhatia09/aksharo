exports[`rendering > produces the same HTML shell for one kind, in both languages > export-ready.en.html 1`] = `
"<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Aksharo</title>
    <style>
      @media only screen and (max-width: 600px) {
        .wrap { padding: 16px !important; }
        .card { padding: 24px 20px !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background:#f6f6f8;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f6f6f8;">
      <tr>
        <td class="wrap" align="center" style="padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans Devanagari',sans-serif;">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;">
            <tr>
              <td style="padding:0 0 16px;font-size:15px;font-weight:700;letter-spacing:0.02em;color:#101014;">Aksharo</td>
            </tr>
            <tr>
              <td class="card" style="background:#ffffff;border:1px solid #e4e4ea;border-radius:12px;padding:32px;">
            <h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#101014;">Your export is ready</h1>
            <p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#101014;">Hi Asha, Diwali promo has finished rendering and is ready to download.</p>
            <p style="margin:24px 0 8px;">
              <a href="https://app.example.test/exports/01J" style="display:inline-block;padding:12px 22px;border-radius:8px;background:#101014;color:#ffffff;font-size:16px;font-weight:600;text-decoration:none;">Download</a>
            </p>
            <p style="margin:0 0 16px;font-size:13px;line-height:1.5;color:#5b5b66;word-break:break-all;">https://app.example.test/exports/01J</p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 4px 0;">
            <p style="margin:0 0 8px;font-size:13px;line-height:1.5;color:#5b5b66;">The file is kept for 7 days, then deleted. Re-export any time from the project.</p>
                <p style="margin:8px 0 0;font-size:13px;line-height:1.5;color:#5b5b66;">Sent by Aksharo. Questions? Reply to this message or write to support@aksharo.ai.</p>
                
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
"
`;

exports[`rendering > renders device-approval in English 1`] = `
{
  "subject": "Approve Studio iMac",
  "text": "Aksharo

Approve a new device

Hi Asha, Studio iMac is asking to sign in to Aksharo from Premiere Pro.

Request from Mumbai, India. Approve it only if you started it.

Approve this device:
https://app.example.test/device?code=WXYZ

The request expires in 10 minutes.
If this was not you, ignore this message — the device stays locked out.

Sent by Aksharo. Questions? Reply to this message or write to support@aksharo.ai.
",
}
`;

exports[`rendering > renders device-approval in Hindi 1`] = `
{
  "subject": "Studio iMac को मंज़ूरी दें",
  "text": "Aksharo

नए डिवाइस को मंज़ूरी दें

नमस्ते Asha, Studio iMac Aksharo में Premiere Pro से साइन इन करना चाहता है।

अनुरोध Mumbai, India से आया है। मंज़ूरी तभी दीजिए जब यह आपने शुरू किया हो।

इस डिवाइस को मंज़ूरी दें:
https://app.example.test/device?code=WXYZ

यह अनुरोध 10 मिनट में ख़त्म हो जाएगा।
अगर यह आपने नहीं किया तो इस मेल को छोड़ दीजिए — डिवाइस बाहर ही रहेगा।

Aksharo की ओर से भेजा गया। कोई सवाल? इसी मेल का जवाब दें या support@aksharo.ai पर लिखें।
",
}
`;

