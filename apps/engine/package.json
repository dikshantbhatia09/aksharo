{
  "name": "@montaj/engine",
  "version": "0.1.0",
  "private": true,
  "description": "montaj-engine: the local sidecar (whisper.cpp, Silero VAD, deep-filter, ffmpeg) the desktop app spawns on demand — model manager, backend detection, localhost HTTP/WS contract.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@montaj/bridge-core": "workspace:*",
    "@montaj/config": "workspace:*",
    "@montaj/engine-client": "workspace:*",
    "@montaj/render-core": "workspace:*",
    "@montaj/render-skia-node": "workspace:*",
    "ulid": "^2.3.0",
    "ws": "^8.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
