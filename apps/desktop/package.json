{
  "name": "@montaj/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell that loads the hosted Aksharo web app (D71), with deep links, electron-updater channels, tray and the embedded local bridge.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/bundle.mjs && node scripts/copy-static.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pack:dry": "pnpm build && node scripts/pack.mjs --dir",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('release',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@montaj/bridge-core": "workspace:*",
    "@montaj/config": "workspace:*",
    "@montaj/edg": "workspace:*",
    "@montaj/engine-client": "workspace:*",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@montaj/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.2",
    "@types/sql.js": "^1.4.9",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
