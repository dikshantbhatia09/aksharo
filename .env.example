# =============================================================================
# Montaj (codename) / Aksharo — example environment
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every variable in docs/CONTRACTS.md §1 appears below, in contract order.
# Defaults are wired to the local `docker compose` stack (postgres, redis, minio).
# =============================================================================

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://montaj:montaj@localhost:5432/montaj?schema=public
REDIS_URL=redis://localhost:6379

# --- Raw object storage (production: AWS S3 ap-south-1; local: MinIO) --------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_RAW=montaj-raw
S3_ACCESS_KEY=montaj-local
S3_SECRET_KEY=montaj-local-secret

# --- Derived object storage (production: Cloudflare R2; local: same MinIO) ---
R2_ENDPOINT=http://localhost:9000
R2_BUCKET_DERIVED=montaj-derived
R2_ACCESS_KEY=montaj-local
R2_SECRET_KEY=montaj-local-secret

# --- Auth (RS256 keypair; PEM with literal \n escapes on one line) ----------
# Generate a dev pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# then paste each PEM with newlines escaped as \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_DEV_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_DEV_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"

# --- Worker -> API completion callbacks (HMAC-SHA256; CONTRACTS §3) ---------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CALLBACK_SECRET=replace-with-32-bytes-of-hex-for-local-development-only
# Second valid verification key during rotation; leave empty normally.
# Put the NEW secret here, roll every worker onto it, then promote it to
# INTERNAL_CALLBACK_SECRET and clear this line. While both are set the API accepts
# a callback signed with either, so no completion is lost mid-roll.
INTERNAL_CALLBACK_SECRET_NEXT=

# --- Google OAuth (PKCE) ----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Origins ----------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- ASR / speech providers -------------------------------------------------
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM --------------------------------------------------------------------
# LLM_PROVIDER: anthropic | openai | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GPU --------------------------------------------------------------------
# GPU_PROVIDER: runpod | modal | replicate | none
GPU_PROVIDER=none

# --- Observability (all optional; empty disables the integration) -----------
SENTRY_DSN=
POSTHOG_KEY=
# Ingestion host for POSTHOG_KEY; not a CONTRACTS §1 variable. Defaults to the EU
# cloud, which is where an Indian workspace should send events rather than US.
POSTHOG_HOST=

# --- Feature flags (JSON object, defaults to {}) ----------------------------
# Read by the API (auth.breachedPasswordCheck) and the web shell
# (growth.streakWidget, realtime.enabled).
FEATURE_FLAGS_JSON={}

# =============================================================================
# Local process settings — NOT part of CONTRACTS §1, safe to change per machine
# =============================================================================
NODE_ENV=development
API_PORT=3001
# TRUST_PROXY=1 makes the API read the client address from `X-Forwarded-For`.
# Set it ONLY when an edge you control rewrites that header, because per-IP rate
# limits and audit rows depend on it (docs/THREAT-MODEL.md T1, T3).
TRUST_PROXY=0
WEB_PORT=3000
LOG_LEVEL=debug

# Redis key prefix for BullMQ queues and realtime pub/sub channels.
# `bull` is BullMQ's own default and what the workers use, so producers and
# consumers only agree when this matches on both sides. Change it to isolate a
# Redis instance shared with another checkout or a parallel test run.
MONTAJ_QUEUE_PREFIX=bull

# Set to 1 to stop this process from running the in-process scheduler worker
# (queue-timeout sweeps and, later, the nightly retention jobs). One-shot
# processes and test runs set it; a deployed API instance does not.
MONTAJ_SCHEDULER_DISABLED=

# =============================================================================
# docker-compose only — consumed by docker-compose.yml, not by application code
# =============================================================================
POSTGRES_USER=montaj
POSTGRES_PASSWORD=montaj
POSTGRES_DB=montaj
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=montaj-local
MINIO_ROOT_PASSWORD=montaj-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
