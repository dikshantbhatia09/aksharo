# =============================================================================
# Montaj (codename) / Aksharo — example environment
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every variable in docs/CONTRACTS.md §1 appears below, in contract order.
# Defaults are wired to the local `docker compose` stack (postgres, redis, minio).
# =============================================================================

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql://montaj:montaj@localhost:5432/montaj?schema=public
REDIS_URL=redis://localhost:6379

# --- Raw object storage (production: AWS S3 ap-south-1; local: MinIO) --------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_RAW=montaj-raw
S3_ACCESS_KEY=montaj-local
S3_SECRET_KEY=montaj-local-secret

# --- Derived object storage (production: Cloudflare R2; local: same MinIO) ---
R2_ENDPOINT=http://localhost:9000
R2_BUCKET_DERIVED=montaj-derived
R2_ACCESS_KEY=montaj-local
R2_SECRET_KEY=montaj-local-secret

# --- Auth (RS256 keypair; PEM with literal \n escapes on one line) ----------
# Generate a dev pair:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# then paste each PEM with newlines escaped as \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_DEV_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_DEV_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"

# --- Worker -> API completion callbacks (HMAC-SHA256; CONTRACTS §3) ---------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CALLBACK_SECRET=replace-with-32-bytes-of-hex-for-local-development-only
# Second valid verification key during rotation; leave empty normally.
# Put the NEW secret here, roll every worker onto it, then promote it to
# INTERNAL_CALLBACK_SECRET and clear this line. While both are set the API accepts
# a callback signed with either, so no completion is lost mid-roll.
INTERNAL_CALLBACK_SECRET_NEXT=

# --- Google OAuth (PKCE) ----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Licence keys (B08) ------------------------------------------------------
# Identifies which JWT_PRIVATE_KEY/JWT_PUBLIC_KEY pair signed a licence-key
# offline payload/revocation snapshot. Bump on key rotation.
LICENSE_SIGNING_KID=k1

# --- Origins ----------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# --- Payments (Razorpay) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- ASR / speech providers -------------------------------------------------
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM --------------------------------------------------------------------
# LLM_PROVIDER: anthropic | openai | mock
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GPU --------------------------------------------------------------------
# GPU_PROVIDER: runpod | modal | replicate | none
GPU_PROVIDER=none
# Endpoint the serverless GPU pool is invoked at, and its bearer token.
# Both empty with GPU_PROVIDER=none, which is the local default.
GPU_PROVIDER_URL=
GPU_PROVIDER_TOKEN=

# --- Observability (all optional; empty disables the integration) -----------
SENTRY_DSN=
POSTHOG_KEY=
# Ingestion host for POSTHOG_KEY; not a CONTRACTS §1 variable. Defaults to the EU
# cloud, which is where an Indian workspace should send events rather than US.
POSTHOG_HOST=

# --- Feature flags (JSON object, defaults to {}) ----------------------------
# Read by the API (auth.breachedPasswordCheck, einvoice_enabled — B05's IRN/QR
# hook, off by default pending the Rs 5 crore e-invoicing trigger) and the web
# shell (growth.streakWidget, realtime.enabled).
FEATURE_FLAGS_JSON={}

# --- Invoices (B05) — optional, NOT part of the frozen CONTRACTS.md §1 list -
# Read directly from process.env by apps/api/src/invoices/, not through the
# validated Env schema, precisely because they are optional and this work
# package could not add to the frozen contract.
#   INVOICE_SIGNING_KEY        HMAC passphrase, or an RSA private key PEM
#                               (BEGIN/END markers), for the invoice PDF's
#                               detached signature. Defaults to
#                               INTERNAL_CALLBACK_SECRET (HMAC) when unset.
#   SUPPLIER_LEGAL_NAME, SUPPLIER_ADDRESS_LINE1/LINE2/CITY/POSTAL_CODE,
#   SUPPLIER_PAN                Aksharo's own registered-office details, as
#                               printed on every invoice. Defaults are obvious
#                               placeholders — set the real values before the
#                               first real invoice (see invoices/README.md).
INVOICE_SIGNING_KEY=
SUPPLIER_LEGAL_NAME=
SUPPLIER_ADDRESS_LINE1=
SUPPLIER_ADDRESS_LINE2=
SUPPLIER_ADDRESS_CITY=
SUPPLIER_ADDRESS_POSTAL_CODE=
SUPPLIER_PAN=

# --- Affiliate payouts (B07) — optional, NOT part of the frozen CONTRACTS.md
# §1 list. RazorpayX Payouts read the same RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET
# above; RAZORPAYX_ACCOUNT_NUMBER is the virtual account payouts are made
# from. `payouts/payout.factory.ts` falls back to FakePayoutProvider unless
# all three are set (there are no RazorpayX keys in this environment — see
# affiliates/README.md). PAN encryption at rest derives its key from
# INTERNAL_CALLBACK_SECRET (no separate secret needed). affiliate_tds_section
# in FEATURE_FLAGS_JSON only toggles the Form 16A stub's "DRAFT" watermark
# pending CA confirmation of 194H vs 194-O (H-18) — it never changes the rate
# withheld.
RAZORPAYX_ACCOUNT_NUMBER=

# --- Transactional mail (A25) -----------------------------------------------
# MAIL_PROVIDER: ses | smtp | dev
#   ses   AWS SES v2. Credentials come from the pod's IRSA role and the region
#         from S3_REGION, so there is no mail key here or in SSM.
#   smtp  Any SMTP server, from SMTP_URL. Mailpit locally:
#           docker compose --profile mail up -d
#           SMTP_URL=smtp://localhost:1025   (web UI on http://localhost:8025)
#   dev   No server at all: messages go to a Redis list the e2e suite reads and
#         `pnpm --filter @montaj/api mail:outbox` prints. The default.
MAIL_PROVIDER=dev
# Envelope sender. Required for ses and smtp; ignored by dev.
# Either `hello@aksharo.ai` or `Aksharo <hello@aksharo.ai>`.
MAIL_FROM=
# Required when MAIL_PROVIDER=smtp; leave empty otherwise.
SMTP_URL=
# SNS topic the SES bounce and complaint feed arrives on. Optional: the SNS
# message signature is already the authentication, and setting this narrows it to
# one topic, so a correctly signed message published to any other one is refused.
# arn:aws:sns:ap-south-1:123456789012:aksharo-mail-events
MAIL_SNS_TOPIC_ARN=

# =============================================================================
# Local process settings — NOT part of CONTRACTS §1, safe to change per machine
# =============================================================================
NODE_ENV=development
API_PORT=3001
# TRUST_PROXY=1 makes the API read the client address from `X-Forwarded-For`.
# Set it ONLY when an edge you control rewrites that header, because per-IP rate
# limits and audit rows depend on it (docs/THREAT-MODEL.md T1, T3).
TRUST_PROXY=0
WEB_PORT=3000
LOG_LEVEL=debug

# Redis key prefix for BullMQ queues and realtime pub/sub channels.
# `bull` is BullMQ's own default and what the workers use, so producers and
# consumers only agree when this matches on both sides. Change it to isolate a
# Redis instance shared with another checkout or a parallel test run.
MONTAJ_QUEUE_PREFIX=bull

# Namespace for every OTHER Redis key the API writes: the auth tokens and the
# development mail outbox, the rate-limit buckets, the notification suppression
# list, the export bundles, the entitlement cache. `montaj` is what every
# deployment uses and what all of those keys have always been called; a test run
# sets a per-suite value so twenty-two e2e suites can share one Redis without
# sweeping each other's keys. Unrelated to MONTAJ_QUEUE_PREFIX above, which the
# workers have to agree with.
MONTAJ_REDIS_PREFIX=montaj

# Set to 0 to stop this process draining the `notify` queue. The consumer runs
# inside the API process (there is no separate notify worker), so exactly one
# deployment needs it on; a one-shot process or a test run turns it off.
NOTIFY_WORKER_ENABLED=1

# Set to 1 to stop this process from running the in-process scheduler worker
# (queue-timeout sweeps and, later, the nightly retention jobs). One-shot
# processes and test runs set it; a deployed API instance does not.
MONTAJ_SCHEDULER_DISABLED=

# D82: set to 1 once the worker-ai image build (X07) has provisioned
# DeepFilterNet3's model weights. Read server-side by `apps/web`'s editor page
# to un-grey the Audio panel's Deep clean tier; Quick clean (spectral gate)
# stays free and available on every lane regardless of this flag.
AUDIO_DEEP_CLEAN_ENABLED=0

# =============================================================================
# docker-compose only — consumed by docker-compose.yml, not by application code
# =============================================================================
POSTGRES_USER=montaj
POSTGRES_PASSWORD=montaj
POSTGRES_DB=montaj
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=montaj-local
MINIO_ROOT_PASSWORD=montaj-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Mailpit (compose profile `mail`): SMTP in, web UI out.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# =============================================================================
# apps/engine (C03a) — local sidecar, desktop-only; not part of CONTRACTS §1's
# frozen API env list, and not read by any server process
# =============================================================================
# Base URL the model manager downloads whisper.cpp/Silero/deep-filter/ffmpeg
# binaries and model weights from (H-22 pattern: versioned manifest,
# SHA-256-verified on download). No weights are ever committed to the repo.
MODEL_WEIGHTS_BASE_URL=https://models.aksharo.ai
# Local override for engine tests/dev: writes the discovery file somewhere
# other than ~/.aksharo/engine.json (defaults to that path when unset).
ENGINE_DISCOVERY_DIR=
# Directory the model manager downloads/verifies/stores model files in
# (defaults to ~/.aksharo/models when unset).
ENGINE_MODELS_DIR=
