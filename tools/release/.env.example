# =============================================================================
# Signing & release pipeline (C00) — CI / GitHub-environment secrets only.
#
# These are NOT application runtime configuration and do NOT belong in the root
# `.env.example` / `docs/CONTRACTS.md` §1 (ruling 2026-09-03): they are consumed only by
# `tools/release`'s CLI, normally as GitHub Actions secrets injected into `release-mac` /
# `release-win` / `release-publish` environments (see `docs/RELEASE.md` for the full list
# and the human checklist before the first signed release). `pnpm release <cmd>` loads this
# file itself (see `src/env.ts`) in addition to `process.env`, so a local `tools/release/.env`
# (copied from this file, never committed) is enough to exercise signed mode by hand.
#
# All blank. `RELEASE_MODE` unset/`dry-run` never reads any of these; the CLI never signs,
# notarizes or uploads for real. Setting `RELEASE_MODE=signed` without every secret the
# chosen provider needs fails the CLI closed (tools/release/src/env.ts::requireSecretsIfSigned).
# =============================================================================

# dry-run (default, safe) | signed (requires every secret below for the chosen provider)
RELEASE_MODE=dry-run

# --- macOS: Developer ID Application signing + notarytool ------------------
APPLE_TEAM_ID=
APPLE_DEVELOPER_ID_APPLICATION_CERT_P12_BASE64=
APPLE_DEVELOPER_ID_APPLICATION_CERT_PASSWORD=
APPLE_NOTARYTOOL_KEY_ID=
APPLE_NOTARYTOOL_ISSUER_ID=
APPLE_NOTARYTOOL_PRIVATE_KEY_BASE64=

# --- Windows OV signing (cloud HSM; no PFX file ever committed) ------------
# azure-trusted-signing | digicert-key-locker (see docs/RELEASE.md "Known gap": Azure
# Trusted Signing public-trust certs are not issued to an Indian entity as of RR-07 §P0;
# digicert-key-locker is the working default until that changes).
WIN_SIGN_PROVIDER=azure-trusted-signing
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_ACCOUNT=
AZURE_TRUSTED_SIGNING_CERT_PROFILE=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
DIGICERT_KEYLOCKER_API_KEY=
DIGICERT_KEYLOCKER_CLIENT_CERT_BASE64=
DIGICERT_KEYLOCKER_CLIENT_CERT_PASSWORD=
DIGICERT_KEYLOCKER_KEYPAIR_ALIAS=
SM_HOST=

# --- Adobe CEP (After Effects panel) ZXP signing ----------------------------
ZXP_CERT_P12_BASE64=
ZXP_CERT_PASSWORD=
ZXP_TIMESTAMP_URL=

# --- Release publishing (R2 releases bucket) --------------------------------
RELEASE_R2_ENDPOINT=
RELEASE_R2_BUCKET=
RELEASE_R2_ACCESS_KEY=
RELEASE_R2_SECRET_KEY=

# --- Checksum manifest signing (SIGNATURES.txt; not code signing) ----------
RELEASE_CHECKSUM_SIGNING_KEY_BASE64=
