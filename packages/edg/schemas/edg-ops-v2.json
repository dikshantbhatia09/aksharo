        "wordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        }
      },
      "required": ["opId", "type", "wordId"],
      "additionalProperties": false,
      "title": "DeleteWord"
    },
    "InsertWordAfter": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "InsertWordAfter"
        },
        "wordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
