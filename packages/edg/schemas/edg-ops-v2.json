      "title": "Resegment"
    },
    "DecideItems": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "DecideItems"
        },
        "itemIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ulid"
          }
        },
        "state": {
          "$ref": "#/$defs/ItemState"
        }
      },
      "required": ["opId", "type", "itemIds", "state"],
      "additionalProperties": false,
      "title": "DecideItems"
    },
    "ItemState": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "modified"],
      "title": "ItemState"
    },
    "MergePass": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
