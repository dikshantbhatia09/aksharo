{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:montaj:schema:edg-ops-v2",
  "title": "EDG ops v2",
  "description": "Semantic EDG ops and the op-batch envelopes (D29, CONTRACTS §2). The root validates one EdgOp; the batch types are under $defs. Generated from @montaj/edg; do not edit by hand.",
  "$ref": "#/$defs/EdgOp",
  "$defs": {
    "EdgOp": {
      "oneOf": [
        {
          "$ref": "#/$defs/SetSegmentText"
        },
        {
          "$ref": "#/$defs/SetSegmentBounds"
        },
        {
          "$ref": "#/$defs/SplitSegment"
        },
        {
          "$ref": "#/$defs/MergeSegments"
        },
        {
          "$ref": "#/$defs/SetEmphasis"
        },
        {
          "$ref": "#/$defs/SetSegmentPosition"
        },
        {
          "$ref": "#/$defs/HideSegment"
        },
        {
          "$ref": "#/$defs/SetStyle"
        },
        {
          "$ref": "#/$defs/EditWord"
        },
        {
          "$ref": "#/$defs/DeleteWord"
        },
        {
          "$ref": "#/$defs/InsertWordAfter"
        },
        {
          "$ref": "#/$defs/SetProtectedRanges"
        },
        {
          "$ref": "#/$defs/SetWordTiming"
        },
        {
          "$ref": "#/$defs/Resegment"
        },
        {
          "$ref": "#/$defs/DecideItems"
        },
        {
          "$ref": "#/$defs/MergePass"
        },
        {
          "$ref": "#/$defs/SetAudio"
        },
        {
          "$ref": "#/$defs/SetRender"
        }
      ],
      "title": "EdgOp",
      "description": "Semantic, id-addressed EDG mutation (D29)"
    },
    "SetSegmentText": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetSegmentText"
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "script": {
          "$ref": "#/$defs/ScriptId"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["opId", "type", "segmentId", "script", "text"],
      "additionalProperties": false,
      "title": "SetSegmentText"
    },
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Ulid",
      "description": "ULID identifier (CONTRACTS §0)",
      "examples": ["01JBZ9F8Q0000000000000000A"]
    },
    "ScriptId": {
      "type": "string",
      "enum": ["roman", "native", "en", "translated"],
      "title": "ScriptId"
    },
    "SetSegmentBounds": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetSegmentBounds"
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        },
        "startWordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        },
        "endWordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        }
      },
      "required": ["opId", "type", "segmentId", "startMs", "endMs"],
      "additionalProperties": false,
      "title": "SetSegmentBounds"
    },
    "SplitSegment": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SplitSegment"
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "atWordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        },
        "newSegmentId": {
          "$ref": "#/$defs/Ulid"
        }
      },
      "required": ["opId", "type", "segmentId", "atWordId", "newSegmentId"],
      "additionalProperties": false,
      "title": "SplitSegment"
    },
    "MergeSegments": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "MergeSegments"
        },
        "segmentIds": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ulid"
          }
        },
        "newSegmentId": {
          "$ref": "#/$defs/Ulid"
        }
      },
      "required": ["opId", "type", "segmentIds", "newSegmentId"],
      "additionalProperties": false,
      "title": "MergeSegments"
    },
    "SetEmphasis": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetEmphasis"
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "wordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        },
        "presetId": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["opId", "type", "segmentId", "wordId", "presetId"],
      "additionalProperties": false,
      "title": "SetEmphasis"
    },
    "PresetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "title": "PresetId"
    },
    "SetSegmentPosition": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetSegmentPosition"
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["opId", "type", "segmentId", "position"],
      "additionalProperties": false,
      "title": "SetSegmentPosition"
    },
    "Position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": ["x", "y", "anchor"],
      "additionalProperties": false,
      "title": "Position"
    },
    "HideSegment": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "HideSegment"
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": ["opId", "type", "segmentId", "hidden"],
      "additionalProperties": false,
      "title": "HideSegment"
    },
    "StyleRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "title": "StyleRef"
    },
    "JsonObject": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "title": "JsonObject"
    },
    "SetStyle": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetStyle"
        },
        "scope": {
          "type": "string",
          "enum": ["doc", "segment"]
        },
        "segmentId": {
          "$ref": "#/$defs/Ulid"
        },
        "styleRef": {
          "$ref": "#/$defs/StyleRef"
        },
        "overrides": {
          "$ref": "#/$defs/JsonObject"
        }
      },
      "required": ["opId", "type", "scope"],
      "additionalProperties": false,
      "title": "SetStyle"
    },
    "EditWord": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "EditWord"
        },
        "wordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
