          "examples": ["0:0", "3:1274"]
        },
        "newWordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        },
        "e": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        }
      },
      "required": ["opId", "type", "wordId", "newWordId", "text", "s", "e"],
      "additionalProperties": false,
      "title": "InsertWordAfter"
    },
    "SetProtectedRanges": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetProtectedRanges"
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Ulid"
              },
              "s": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "title": "Milliseconds"
              },
              "e": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "title": "Milliseconds"
              }
            },
            "required": ["id", "s", "e"],
            "additionalProperties": false
          }
        }
      },
      "required": ["opId", "type", "ranges"],
      "additionalProperties": false,
      "title": "SetProtectedRanges"
    },
    "SetWordTiming": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "SetWordTiming"
        },
        "wordId": {
          "type": "string",
          "pattern": "^\\d+:\\d+$",
          "title": "WordId",
          "description": "Stable word id \"<chunkIdx>:<n>\", allocated once and never reused (D28)",
          "examples": ["0:0", "3:1274"]
        },
        "s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        },
        "e": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        }
      },
      "required": ["opId", "type", "wordId", "s", "e"],
      "additionalProperties": false,
      "title": "SetWordTiming"
    },
    "Resegment": {
      "type": "object",
      "properties": {
        "opId": {
          "$ref": "#/$defs/Ulid"
        },
        "type": {
          "type": "string",
          "const": "Resegment"
        },
        "maxChars": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "maxLines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 6
        },
        "minMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        },
        "maxMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "title": "Milliseconds"
        }
      },
      "required": ["opId", "type", "maxChars", "maxLines", "minMs", "maxMs"],
