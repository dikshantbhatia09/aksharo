{
  "name": "@montaj/edg",
  "version": "0.1.0",
  "private": true,
  "description": "EDG v2 types, Zod schemas, the EdgOp union, rebase transforms and migrations.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "fixtures"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/esm/schemas/index.d.ts",
        "default": "./dist/esm/schemas/index.js"
      },
      "require": {
        "types": "./dist/schemas/index.d.ts",
        "default": "./dist/schemas/index.js"
      }
    },
    "./seq": {
      "import": {
        "types": "./dist/esm/seq.d.ts",
        "default": "./dist/esm/seq.js"
      },
      "require": {
        "types": "./dist/seq.d.ts",
        "default": "./dist/seq.js"
      }
    },
    "./ops": {
      "import": {
        "types": "./dist/esm/ops/index.d.ts",
        "default": "./dist/esm/ops/index.js"
      },
      "require": {
        "types": "./dist/ops/index.d.ts",
        "default": "./dist/ops/index.js"
      }
    },
    "./segmenter": {
      "import": {
        "types": "./dist/esm/segmenter/index.d.ts",
        "default": "./dist/esm/segmenter/index.js"
      },
      "require": {
        "types": "./dist/segmenter/index.d.ts",
        "default": "./dist/segmenter/index.js"
      }
    },
    "./migrations": {
      "import": {
        "types": "./dist/esm/migrations/index.d.ts",
        "default": "./dist/esm/migrations/index.js"
      },
      "require": {
        "types": "./dist/migrations/index.d.ts",
        "default": "./dist/migrations/index.js"
      }
    },
    "./schemas/edg-v2.json": "./schemas/edg-v2.json",
    "./schemas/edg-ops-v2.json": "./schemas/edg-ops-v2.json",
    "./fixtures/sample-project.json": "./fixtures/sample-project.json",
    "./package.json": "./package.json",
    "./fixtures/segmenter-golden.json": "./fixtures/segmenter-golden.json"
  },
  "scripts": {
    "build": "pnpm run schemas:build && tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/finalise-esm-build.mjs",
    "schemas:build": "tsx scripts/generate-json-schemas.ts",
    "golden:build": "tsx scripts/build-segmenter-golden.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@montaj/config": "workspace:*",
    "@types/node": "^22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
