{
  "name": "@montaj/render-skia-node",
  "version": "0.1.0",
  "private": true,
  "description": "@napi-rs/canvas (Skia) backend for the cloud render service.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "parity": "tsx scripts/parity-report.ts"
  },
  "devDependencies": {
    "@montaj/caption-styles": "workspace:*",
    "@montaj/config": "workspace:*",
    "@montaj/render-canvaskit": "workspace:*",
    "@types/node": "^22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "canvaskit-wasm": "0.42.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@montaj/render-core": "workspace:*",
    "@napi-rs/canvas": "1.0.8"
  }
}
