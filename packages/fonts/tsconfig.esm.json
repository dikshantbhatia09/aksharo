{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "./dist/esm",
    "tsBuildInfoFile": "./dist/esm/.tsbuildinfo.build"
  },
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "src/**/*.test.ts",
    "e2e",
    "scripts",
    "src/node.ts",
    "src/pack.ts",
    "src/subset.ts",
    "src/validate.ts",
    "src/pipeline.ts",
    "src/testing.ts"
  ]
}
