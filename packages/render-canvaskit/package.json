{
  "name": "@montaj/render-canvaskit",
  "version": "0.1.0",
  "private": true,
  "description": "CanvasKit (Skia WASM, WebGL) backend for the browser and the desktop app.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/finalise-esm-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "baseline:build": "tsx scripts/build-png-baselines.ts",
    "previews:build": "tsx scripts/build-style-previews.ts"
  },
  "devDependencies": {
    "@montaj/config": "workspace:*",
    "@types/node": "^22.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@montaj/caption-styles": "workspace:*",
    "@montaj/render-core": "workspace:*",
    "canvaskit-wasm": "0.42.0"
  },
  "module": "./dist/esm/index.js"
}
