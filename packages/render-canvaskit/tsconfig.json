{
  "extends": "@montaj/config/tsconfig.node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", ".turbo", "e2e/.artifacts"]
}
