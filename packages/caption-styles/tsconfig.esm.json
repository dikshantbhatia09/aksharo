{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "./dist/esm",
    "tsBuildInfoFile": "./dist/esm/.tsbuildinfo.build"
  },
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "src/**/*.test.ts",
    "scripts",
    "src/index.ts",
    "src/registry.ts"
  ]
}
