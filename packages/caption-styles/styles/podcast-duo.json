{
  "id": "podcast-duo",
  "name": "Podcast Duo",
  "version": 2,
  "category": "podcast",
  "minPlan": "creator",
  "typography": {
    "fontFamily": "Montserrat",
    "fallbacks": [
      "Noto Sans Devanagari",
      "Noto Sans Tamil",
      "Noto Sans"
    ],
    "weight": 600,
    "italic": false,
    "sizePct": 3.6,
    "lineHeight": 1.3,
    "letterSpacingEm": 0.005,
    "textTransform": "none",
    "scriptScale": {
      "deva": 0.91,
      "taml": 0.55
    }
  },
  "colors": {
    "text": "#f5f7fb",
    "activeText": "#f5f7fb",
    "accent": "#f2a541"
  },
  "box": {
    "enabled": true,
    "mode": "line",
    "fill": "#12141c",
    "paddingPct": 26,
    "radiusPct": 50,
    "opacity": 0.82
  },
  "stroke": {
    "enabled": false,
    "widthPct": 0
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 4,
    "blurPct": 18,
    "opacity": 0.4
  },
  "layout": {
    "anchor": "bottom-left",
    "x": 0.08,
    "y": 0.86,
    "align": "left",
    "maxWidthPct": 72,
    "maxLines": 2,
    "safeAreaPct": 10
  },
  "animation": {
    "in": {
      "type": "slide-up",
      "durationMs": 180
    },
    "out": {
      "type": "fade",
      "durationMs": 160
    },
    "wordHighlight": {
      "type": "underline",
      "durationMs": 120
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "speaker",
      "label": "Speaker",
      "color": "#f2a541",
      "weight": 700,
      "effect": "none"
    },
    {
      "id": "quote",
      "label": "Quote",
      "effect": "highlight"
    }
  ],
  "assRenderable": false,
  "assExportable": true,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/podcast-duo.mp4",
  "parityScore": 0.9145
}
