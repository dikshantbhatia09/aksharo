{
  "id": "impact-shout",
  "name": "Impact Shout",
  "version": 2,
  "category": "bold",
  "minPlan": "starter",
  "typography": {
    "fontFamily": "Anton",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 400,
    "italic": false,
    "sizePct": 8.5,
    "lineHeight": 1,
    "letterSpacingEm": -0.02,
    "textTransform": "uppercase"
  },
  "colors": {
    "text": "#ffffff",
    "activeText": "#ff2e63",
    "accent": "#ff2e63"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#0b0b0f",
    "widthPct": 10
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 7,
    "blurPct": 8,
    "opacity": 0.6
