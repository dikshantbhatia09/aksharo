      "type": "bounce",
      "durationMs": 260
    },
    "out": {
      "type": "fade",
      "durationMs": 100
    },
    "wordHighlight": {
      "type": "none",
      "durationMs": 0
    },
    "perWord": true
  },
  "emphasisPresets": [
    {
      "id": "shout",
      "label": "Shout",
      "color": "#ff2e63",
      "scale": 1.3,
      "effect": "shake"
    }
  ],
  "assRenderable": false,
  "assExportable": false,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/impact-shout.mp4"
