{
  "id": "estate-slide-rtl",
  "name": "Real Estate: Slide RtL",
  "version": 2,
  "category": "clean",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Inter",
    "fallbacks": [
      "Noto Sans Devanagari",
      "Noto Sans Tamil",
      "Noto Sans"
    ],
    "weight": 500,
    "italic": true,
    "sizePct": 4.4,
    "lineHeight": 1.25,
    "letterSpacingEm": -0.01,
    "textTransform": "none",
    "scriptScale": {
      "taml": 0.68,
      "deva": 0.85
    }
  },
  "colors": {
    "text": "#ffffff"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#000000",
    "widthPct": 5
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 2,
    "blurPct": 6,
    "opacity": 0.6
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.85,
    "align": "center",
    "maxWidthPct": 85,
    "maxLines": 2,
    "safeAreaPct": 8
  },
  "animation": {
    "in": {
      "type": "slide-right",
      "durationMs": 250
    },
    "out": {
      "type": "slide-right",
      "durationMs": 200
    },
    "wordHighlight": {
      "type": "none",
      "durationMs": 0
    },
    "perWord": false,
    "cueScope": "word"
  },
  "emphasisPresets": [
    {
      "id": "accent",
      "label": "Accent",
      "color": "#ffd400",
      "effect": "none"
    }
  ],
  "assRenderable": true,
  "assExportable": true,
  "requiresLayoutMetrics": false,
  "parityScore": 0.96
}
