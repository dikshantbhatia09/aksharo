{
  "id": "estate-bounce",
  "name": "Real Estate: Dynamic Bounce",
  "version": 2,
  "category": "playful",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Inter",
    "fallbacks": [
      "Noto Sans Devanagari",
      "Noto Sans Tamil",
      "Noto Sans"
    ],
    "weight": 900,
    "italic": false,
    "sizePct": 4.8,
    "lineHeight": 1.2,
    "letterSpacingEm": -0.01,
    "textTransform": "uppercase",
    "scriptScale": {
      "taml": 0.68,
      "deva": 0.85
    }
  },
  "colors": {
    "text": "#ffffff",
    "activeText": "#ffd400"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#000000",
    "widthPct": 7
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 3,
    "blurPct": 8,
    "opacity": 0.7
  },
  "layout": {
    "anchor": "center",
    "x": 0.5,
    "y": 0.75,
    "align": "center",
    "maxWidthPct": 85,
    "maxLines": 2,
    "safeAreaPct": 8
  },
  "animation": {
    "in": {
      "type": "bounce",
      "durationMs": 250
    },
    "out": {
      "type": "fade",
      "durationMs": 150
    },
    "wordHighlight": {
      "type": "scale",
      "durationMs": 120,
      "scale": 1.2
    },
    "perWord": true
  },
  "emphasisPresets": [
    {
      "id": "accent",
      "label": "Accent",
      "color": "#ffd400",
      "effect": "none"
    }
  ],
  "assRenderable": true,
  "assExportable": true,
  "requiresLayoutMetrics": false,
  "parityScore": 0.96
}
