{
  "id": "minimal-lower-third",
  "name": "Minimal Lower Third",
  "version": 2,
  "category": "minimal",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Inter",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 500,
    "italic": false,
    "sizePct": 3.2,
    "lineHeight": 1.35,
    "letterSpacingEm": 0.01,
    "textTransform": "none"
  },
  "colors": {
