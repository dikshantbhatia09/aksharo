{
  "id": "stroke-heavy",
  "name": "Stroke Heavy",
  "version": 2,
  "category": "bold",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Montserrat",
    "fallbacks": [
      "Noto Sans Devanagari",
      "Noto Sans Tamil",
      "Noto Sans"
    ],
    "weight": 900,
    "italic": false,
    "sizePct": 6,
    "lineHeight": 1.1,
    "letterSpacingEm": -0.005,
