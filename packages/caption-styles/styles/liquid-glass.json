{
  "id": "liquid-glass",
  "name": "Liquid Glass",
  "version": 2,
  "category": "minimal",
  "minPlan": "studio",
  "typography": {
    "fontFamily": "Inter",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 600,
    "italic": false,
    "sizePct": 4.4,
    "lineHeight": 1.3,
    "letterSpacingEm": 0.005,
    "textTransform": "none"
  },
  "colors": {
    "text": "#ffffff",
    "activeText": "#ffffff",
    "upcomingText": "#ffffffb3"
  },
  "box": {
    "enabled": true,
    "mode": "block",
    "fill": "#ffffff",
    "paddingPct": 30,
    "radiusPct": 36,
    "opacity": 0.16
  },
  "stroke": {
    "enabled": false,
    "widthPct": 0
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 3,
    "blurPct": 14,
    "opacity": 0.25
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.8,
    "align": "center",
    "maxWidthPct": 76,
    "maxLines": 3,
    "safeAreaPct": 14
  },
  "animation": {
    "in": {
      "type": "blur",
      "durationMs": 260
    },
    "out": {
      "type": "fade",
      "durationMs": 200
    },
    "wordHighlight": {
      "type": "color",
      "durationMs": 160
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "accent",
      "label": "Accent",
      "color": "#9be7ff",
      "effect": "none"
    }
  ],
  "assRenderable": false,
  "assExportable": false,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/liquid-glass.mp4"
}
