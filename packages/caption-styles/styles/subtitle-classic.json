{
  "id": "subtitle-classic",
  "name": "Subtitle Classic",
  "version": 2,
  "category": "minimal",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Inter",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 500,
    "italic": false,
    "sizePct": 3.6,
    "lineHeight": 1.3,
    "letterSpacingEm": 0,
    "textTransform": "none",
    "scriptScale": { "latn": 0.94, "taml": 0.68 }
  },
  "colors": {
    "text": "#ffffff"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#000000",
    "widthPct": 5
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 2,
    "blurPct": 6,
    "opacity": 0.55
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.9,
    "align": "center",
    "maxWidthPct": 88,
    "maxLines": 2,
    "safeAreaPct": 8
  },
  "animation": {
    "in": {
      "type": "none",
      "durationMs": 0
    },
    "out": {
      "type": "none",
      "durationMs": 0
    },
    "wordHighlight": {
      "type": "none",
      "durationMs": 0
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "accent",
      "label": "Accent",
      "color": "#ffd400",
      "effect": "none"
    }
  ],
  "assRenderable": false,
  "assExportable": false,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/subtitle-classic.mp4"
}
