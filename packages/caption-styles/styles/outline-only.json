{
  "id": "outline-only",
  "name": "Outline Only",
  "version": 2,
  "category": "clean",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Montserrat",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 800,
    "italic": false,
    "sizePct": 2.33,
    "lineHeight": 1.14,
    "letterSpacingEm": 0.01,
    "textTransform": "uppercase"
  },
  "colors": {
    "text": "#ffffff00",
    "activeText": "#ffffff",
    "accent": "#ffffff"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#ffffff",
    "widthPct": 4
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 2,
    "blurPct": 10,
    "opacity": 0.5
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.76,
    "align": "center",
    "maxWidthPct": 84,
    "maxLines": 2,
    "safeAreaPct": 12
  },
  "animation": {
    "in": {
      "type": "fade",
      "durationMs": 160
    },
    "out": {
      "type": "fade",
      "durationMs": 140
    },
    "wordHighlight": {
      "type": "color",
      "durationMs": 120
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "fill",
      "label": "Fill",
      "color": "#ffd400",
      "effect": "none"
    }
  ],
  "assRenderable": false,
  "assExportable": false,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/outline-only.mp4"
}
