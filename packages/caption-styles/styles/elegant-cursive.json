{
  "id": "elegant-cursive",
  "name": "Elegant Cursive",
  "version": 2,
  "category": "cinematic",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Dancing Script",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 700,
    "italic": false,
    "sizePct": 5.2,
    "lineHeight": 1.3,
    "letterSpacingEm": 0,
    "textTransform": "none",
    "scriptScale": {
      "deva": 0.75,
      "taml": 0.55
    }
  },
  "colors": {
    "text": "#fdf6ec",
    "activeText": "#f3c969",
    "accent": "#f3c969"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0
  },
  "stroke": {
    "enabled": false,
    "widthPct": 0
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 4,
    "blurPct": 14,
    "opacity": 0.45
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.8,
    "align": "center",
    "maxWidthPct": 80,
    "maxLines": 2,
    "safeAreaPct": 10
  },
  "animation": {
    "in": {
      "type": "fade",
      "durationMs": 260
    },
    "out": {
      "type": "fade",
      "durationMs": 200
    },
    "wordHighlight": {
      "type": "color",
      "durationMs": 140
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "glow-word",
      "label": "Glow",
      "color": "#f3c969",
      "effect": "glow"
    }
  ],
  "assRenderable": true,
  "assExportable": true,
  "requiresLayoutMetrics": true,
  "parityScore": 0.9504
}
