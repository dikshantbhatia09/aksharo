{
  "id": "estate-editorial-luxury",
  "name": "Real Estate: Luxury Editorial",
  "version": 2,
  "category": "cinematic",
  "minPlan": "free",
  "typography": {
    "fontFamily": "Playfair Display",
    "fallbacks": [
      "Noto Sans Devanagari",
      "Noto Sans Tamil",
      "Noto Sans"
    ],
    "weight": 600,
    "italic": true,
    "sizePct": 4.5,
    "lineHeight": 1.3,
    "letterSpacingEm": 0.02,
    "textTransform": "none",
    "scriptScale": {
      "taml": 0.68,
      "deva": 0.85
    }
  },
  "colors": {
    "text": "#ffffff"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#000000",
    "widthPct": 4
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 2,
    "blurPct": 6,
    "opacity": 0.6
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.86,
    "align": "center",
    "maxWidthPct": 85,
    "maxLines": 2,
    "safeAreaPct": 8
  },
  "animation": {
    "in": {
      "type": "fade",
      "durationMs": 300
    },
    "out": {
      "type": "fade",
      "durationMs": 200
    },
    "wordHighlight": {
      "type": "color",
      "durationMs": 150
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "accent",
      "label": "Accent",
      "color": "#ffd400",
      "effect": "none"
    }
  ],
  "assRenderable": true,
  "assExportable": true,
  "requiresLayoutMetrics": false,
  "parityScore": 0.96
}
