{
  "id": "typewriter-mono",
  "name": "Typewriter Mono",
  "version": 2,
  "category": "retro",
  "minPlan": "starter",
  "typography": {
    "fontFamily": "Roboto Mono",
    "fallbacks": ["Noto Sans Devanagari", "Noto Sans Tamil", "Noto Sans"],
    "weight": 500,
    "italic": false,
    "sizePct": 4,
    "lineHeight": 1.34,
    "letterSpacingEm": 0.02,
    "textTransform": "none",
    "scriptScale": {
      "deva": 0.9,
      "taml": 0.55
    }
  },
  "colors": {
    "text": "#eaffe6",
    "activeText": "#8cff6b",
    "accent": "#8cff6b"
  },
  "box": {
    "enabled": true,
    "mode": "block",
    "fill": "#07120a",
    "paddingPct": 26,
    "radiusPct": 6,
    "opacity": 0.72
  },
  "stroke": {
    "enabled": false,
    "widthPct": 0
  },
  "shadow": {
    "enabled": false,
    "offsetXPct": 0,
    "offsetYPct": 0,
    "blurPct": 0,
    "opacity": 0
  },
  "layout": {
    "anchor": "bottom-center",
    "x": 0.5,
    "y": 0.8,
    "align": "left",
    "maxWidthPct": 80,
    "maxLines": 3,
    "safeAreaPct": 12
  },
  "animation": {
    "in": {
      "type": "typewriter",
      "durationMs": 900
    },
    "out": {
      "type": "fade",
      "durationMs": 160
    },
    "wordHighlight": {
      "type": "underline",
      "durationMs": 120
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "accent",
      "label": "Accent",
      "color": "#8cff6b",
      "effect": "underline"
    }
  ],
  "assRenderable": false,
  "assExportable": true,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/typewriter-mono.mp4",
  "parityScore": 0.8531
}
