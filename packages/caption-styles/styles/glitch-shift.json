{
  "id": "glitch-shift",
  "name": "Glitch Shift",
  "version": 2,
  "category": "gaming",
  "minPlan": "creator",
  "typography": {
    "fontFamily": "Anton",
    "fallbacks": [
      "Noto Sans Devanagari",
      "Noto Sans Tamil",
      "Noto Sans"
    ],
    "weight": 400,
    "italic": false,
    "sizePct": 6.2,
    "lineHeight": 1.08,
    "letterSpacingEm": 0.01,
    "textTransform": "uppercase"
  },
  "colors": {
    "text": "#ffffff",
    "activeText": "#ff2e63",
    "accent": "#00fff0"
  },
  "box": {
    "enabled": false,
    "mode": "line",
    "paddingPct": 16,
    "radiusPct": 20,
    "opacity": 0.7
  },
  "stroke": {
    "enabled": true,
    "color": "#07070c",
    "widthPct": 7
  },
  "shadow": {
    "enabled": true,
    "color": "#000000",
    "offsetXPct": 0,
    "offsetYPct": 3,
    "blurPct": 8,
    "opacity": 0.6
  },
  "layout": {
    "anchor": "center",
    "x": 0.5,
    "y": 0.5,
    "align": "center",
    "maxWidthPct": 88,
    "maxLines": 2,
    "wordsPerCue": 3,
    "safeAreaPct": 10
  },
  "animation": {
    "in": {
      "type": "pop",
      "durationMs": 90
    },
    "out": {
      "type": "none",
      "durationMs": 0
    },
    "wordHighlight": {
      "type": "color",
      "durationMs": 80
    },
    "perWord": false
  },
  "emphasisPresets": [
    {
      "id": "shout",
      "label": "Shout",
      "color": "#ff2e63",
      "scale": 1.3,
      "effect": "shake"
    },
    {
      "id": "cyan",
      "label": "Cyan",
      "color": "#00fff0",
      "effect": "none"
    }
  ],
  "assRenderable": false,
  "assExportable": false,
  "requiresLayoutMetrics": true,
  "previewKey": "system/style-previews/glitch-shift.mp4"
}
