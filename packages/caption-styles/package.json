{
  "name": "@montaj/caption-styles",
  "version": "0.1.0",
  "private": true,
  "description": "StyleDoc v2 schema, the 30+ system styles and CI-written parity flags.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/registry.json": "./styles/registry.json",
    "./styles/*.json": "./styles/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@montaj/config": "workspace:*",
    "@types/node": "^22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
