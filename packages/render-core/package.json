{
  "name": "@montaj/render-core",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-independent caption layout (HarfBuzz-wasm, bundled subset fonts) producing DrawCommand[].",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@montaj/config": "workspace:*",
    "@types/node": "^22.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
