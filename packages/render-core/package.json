{
  "name": "@montaj/render-core",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-independent caption layout (HarfBuzz-wasm, bundled subset fonts) producing DrawCommand[].",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json && node scripts/finalise-esm-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "golden:build": "tsx scripts/build-goldens.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@montaj/caption-styles": "workspace:*",
    "@montaj/edg": "workspace:*",
    "@montaj/timemap": "workspace:*",
    "harfbuzzjs": "1.6.1"
  },
  "devDependencies": {
    "@montaj/config": "workspace:*",
    "@types/node": "^22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "module": "./dist/esm/index.js"
}
