datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// -----------------------------------------------------------------------------
// Users, Workspaces & Quota Accounts
// -----------------------------------------------------------------------------

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  fullName      String
  avatarUrl     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspaces    WorkspaceMember[]
  subscriptions Subscription[]
}

model Workspace {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  members       WorkspaceMember[]
  projects      Project[]
  presets       Preset[]
  customFonts   CustomFont[]
  brandAssets   BrandAsset[]
  quota         WorkspaceQuota?
  cloudIntegrations WorkspaceCloudIntegration[]
  cloudImportJobs   CloudImportJob[]
  zoomIntegration   WorkspaceZoomIntegration?
  uploadSessions    MediaUploadSession[]
  podcastShows      PodcastShow[]
  workspaceBrandKit WorkspaceBrandKit?
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("owner") // owner, editor, viewer

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// Direct parity with Kalakar sidebar meters:
// Storage: 0 GB / 5.0 GB, Transcription: 5.0 mins left, Audio Clean: 0 / 3
model WorkspaceQuota {
  id                      String    @id @default(uuid())
  workspaceId             String    @unique
  planTier                String    @default("FREE") // FREE, CREATOR, STUDIO
  billingPeriod           String    @default("MONTHLY") // MONTHLY, ANNUAL

  // Storage Quota (bytes)
  storageLimitBytes       BigInt    @default(5368709120) // 5.0 GB
  storageUsedBytes        BigInt    @default(0)

  // Transcription Quota (seconds)
  transcriptionLimitSec   Int       @default(300) // 5.0 minutes (300 seconds)
  transcriptionSecondsRemaining Int @default(300)

  // Audio Clean Credits (units)
  audioCleanCreditsLimit  Int       @default(3) // 3 credits
  audioCleanCreditsRemaining Int    @default(3)

  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Projects, Media & Captions
// -----------------------------------------------------------------------------

model Project {
  id                  String         @id @default(uuid())
  workspaceId         String
  title               String         @default("Untitled Video")
  durationSec         Float?         @default(0.0)
  aspectRatio         String         @default("9:16")
  fps                 Float          @default(30.0)
  status              String         @default("READY") // UPLOADING, PROCESSING, READY, FAILED
  sourceMediaUrl      String?
  filmstripSpriteUrl  String?
  waveformJsonUrl     String?

  detectedLanguage    String         @default("hi")
  script              String         @default("latin") // latin (Hinglish), native (Devanagari)

  transcript          Transcript?
  youtubeSourceMetadata YouTubeSourceMetadata?
  streamVodMetadata   StreamVodMetadata?
  transcriptChapters  TranscriptChapter[]
  styleDocument       Json?          // Full StyleDocSchema JSON
  captionSettings     Json?          // DisplaySettings, Actions, Timing Delay

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exports             ExportJob[]
  clips               Clip[]
  brollCues           ProjectBrollCue[]
}

model Clip {
  id               String   @id @default(uuid())
  projectId        String
  title            String   @default("Untitled Clip")
  startSec         Float
  endSec           Float
  isManualOverride Boolean  @default(false)
  manualStartSec   Float?
  manualEndSec     Float?
  musicTrackId     String?
  musicVolume      Float?   @default(0.15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  musicTrack       MusicTrack? @relation(fields: [musicTrackId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model MediaAsset {
  id               String    @id @default(uuid())
  originalFileName String
  fileSizeBytes    BigInt
  mimeType         String
  durationMs       Int
  width            Int
  height           Int
  fps              Float     @default(30.0)

  sourceVideoUri   String
  proxyVideoUri    String?   // 720p fast-start H.264
  audioWavUri      String?   // 16kHz mono WAV
  audioCleanUri    String?   // DeepFilterNet enhanced WAV
  waveformUri      String?   // JSON amplitude peaks
  filmstripUri     String?   // WebP sprite sheet of video frames

  isHdr           Boolean   @default(false)
  colorTransfer   String?   // bt709, arib-std-b67, smpte2084
  colorPrimaries  String?   // bt709, bt2020
  colorSpace      String?

  audioTracks     MediaAudioTrack[]

  createdAt        DateTime  @default(now())
}

model MediaAudioTrack {
  id           String    @id @default(uuid())
  mediaAssetId String
  streamIndex  Int
  channelIndex Int       @default(0)
  label        String?   // "Host", "Guest", "Game Audio"
  audioWavUri  String    // S3 URI of isolated 16kHz WAV
  durationMs   Int
  isDialogue   Boolean   @default(true)
  speakerName  String?

  createdAt    DateTime  @default(now())

  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId])
  @@map("media_audio_tracks")
}

model Transcript {
  id               String    @id @default(uuid())
  projectId        String    @unique
  detectedLanguage String    @default("hi")
  script           String    @default("latin")
  words            Json      @default("[]") // [{ id, text, start, end, confidence, isEmphasized, emoji }]
  lines            Json      @default("[]") // Array of CaptionLine objects with word timings

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Presets, Custom Fonts & Brand Library
// -----------------------------------------------------------------------------

model Preset {
  id            String    @id @default(uuid())
  workspaceId   String
  userId        String?
  name          String    // e.g. "Ali Abdaal", "Mr Beast 1", "My Viral Glow"
  isBuiltin     Boolean   @default(false)
  styleDoc      Json      // StyleDocSchema
  previewTags   String[]  @default([])

  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CustomFont {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  family      String
  format      String    @default("truetype") // truetype / opentype / woff2
  fontUrl     String    // font file URL
  fontFace    String    @default("Regular")

  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BrandAsset {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  fileUri     String
  assetType   String    // IMAGE, AUDIO, OVERLAY

  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceBrandKit {
  id              String    @id @default(uuid())
  workspaceId     String    @unique
  logoUrl         String?
  logoPosition    String    @default("TOP_LEFT") // TOP_LEFT, TOP_RIGHT
  logoScalePct    Int       @default(15) // 15% width
  logoOpacity     Float     @default(0.85)
  socialHandle    String?   // e.g. "@crestmond"
  introVideoUrl   String?   // S3 URI of intro bumper MP4
  outroVideoUrl   String?   // S3 URI of outro bumper MP4
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ExportJob {
  id             String    @id @default(uuid())
  projectId      String
  presetPlatform String    @default("reels") // reels, story, feed, tiktok, shorts
  resolution     String    @default("1080p") // 720p, 1080p, 4k
  fps            Int       @default(30)
  overlayOpacity Float     @default(1.0)
  status         String    @default("QUEUED") // QUEUED, RENDERING, COMPLETED, FAILED
  outputVideoUri String?
  errorMessage   String?

  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String    @id @default(uuid())
  userId         String
  planTier       String    @default("FREE")
  status         String    @default("active")
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model YouTubeSourceMetadata {
  id              String    @id @default(uuid())
  projectId       String    @unique
  videoId         String
  channelTitle    String
  channelUrl      String?
  viewCount       BigInt?
  publishedAt     DateTime?
  nativeChapters  Json      @default("[]")
  ingestMode      String    @default("SPLIT_STREAM")
  egressProxyNode String?
  createdAt       DateTime  @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StreamVodMetadata {
  id              String   @id @default(uuid())
  projectId       String   @unique
  platform        String   // TWITCH, YOUTUBE_LIVE, KICK
  vodId           String
  totalDurationSec Float
  chatVelocity    Json?    // [{ timestampSec: number, mps: number, topKeywords: string[] }]
  selectedRanges  Json     // [{ startSec: number, endSec: number }]
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TranscriptChapter {
  id        String   @id @default(uuid())
  projectId String
  title     String
  startMs   Int
  endMs     Int
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model WorkspaceCloudIntegration {
  id           String    @id @default(uuid())
  workspaceId  String
  provider     String    // GOOGLE_DRIVE, DROPBOX, ONEDRIVE, BOX
  accountEmail String
  accessToken  String    // Encrypted AES-256-GCM
  refreshToken String?   // Encrypted AES-256-GCM
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, provider, accountEmail])
}

model CloudImportJob {
  id            String    @id @default(uuid())
  workspaceId   String
  projectId     String?
  provider      String
  fileId        String
  fileName      String
  fileSizeBytes BigInt
  status        String    @default("QUEUED") // QUEUED, STREAMING, COMPLETED, FAILED
  progressPct   Int       @default(0)
  errorMessage  String?
  s3Key         String?
  sourceUrl     String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceZoomIntegration {
  id             String    @id @default(uuid())
  workspaceId    String    @unique
  zoomUserId     String
  zoomEmail      String
  accessToken    String    // AES-256-GCM
  refreshToken   String    // AES-256-GCM
  expiresAt      DateTime
  autoRepurpose  Boolean   @default(true)
  minDurationSec Int       @default(600) // 10 minutes minimum
  nameFilter     String?   // Regex or tag filter
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ZoomRecordingEvent {
  id          String    @id @default(uuid())
  meetingId   String    @unique
  workspaceId String?
  topic       String
  durationMin Int
  fileCount   Int
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, IGNORED, FAILED
  projectId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MediaUploadSession {
  id             String    @id @default(uuid())
  workspaceId    String
  uploadId       String    // S3 Multipart Upload ID
  s3Key          String
  fileName       String
  fileSizeBytes  BigInt
  mimeType       String
  chunkSizeBytes Int       @default(16777216) // 16MB
  totalParts     Int
  completedParts Int       @default(0)
  status         String    @default("UPLOADING") // UPLOADING, COMPLETED, ABORTED, EXPIRED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// Podcast RSS Ingestion & Automated Episode Watcher
// -----------------------------------------------------------------------------

model PodcastShow {
  id             String           @id @default(uuid())
  workspaceId    String
  title          String
  feedUrl        String           @unique
  author         String?
  imageUrl       String?
  lastBuildDate  DateTime?
  etag           String?
  autoRepurpose  Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  episodes       PodcastEpisode[]
}

model PodcastEpisode {
  id           String       @id @default(uuid())
  showId       String
  guid         String       @unique
  title        String
  audioUrl     String
  durationSec  Float?
  publishedAt  DateTime
  isProcessed  Boolean      @default(false)
  projectId    String?
  description  String?
  summary      String?
  chapters     Json?        @default("[]")
  createdAt    DateTime     @default(now())

  show         PodcastShow  @relation(fields: [showId], references: [id], onDelete: Cascade)
}

model MusicTrack {
  id           String      @id @default(uuid())
  title        String
  artist       String      @default("Aksharo Originals")
  mood         String      // ENERGETIC, CHILL, DRAMATIC, CORPORATE, INSPIRATIONAL, MYSTERIOUS
  tempo        String      // SLOW, MEDIUM, FAST
  bpm          Int?
  durationSec  Float
  previewUri   String      // CDN 128kbps MP3
  masterUri    String      // CDN 320kbps WAV
  waveformJson String?     // JSON peaks for UI player
  isPublic     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  clips        Clip[]

  @@map("music_tracks")
}

// -----------------------------------------------------------------------------
// B-Roll Visual Cues & Generative Insertion (Pillar 6 §01)
// -----------------------------------------------------------------------------

model ProjectBrollCue {
  id             String    @id @default(uuid())
  projectId      String
  startSec       Float
  endSec         Float
  query          String
  stockVideoUri  String
  sourceProvider String    // PEXELS, STORYBLOCKS, PIXABAY
  status         String    @default("ACTIVE") // ACTIVE, MUTED, DELETED

  createdAt      DateTime  @default(now())

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_broll_cues")
}

