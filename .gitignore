apps/api/.openapi/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Next.js ----
.next/
.next-*/
.vercel/
# apps/web/next-env.d.ts is committed so `tsc --noEmit` works before a build.

# ---- Playwright ----
playwright-report/
test-results/
blob-report/
.playwright/
playwright/.cache/
apps/web/qa-sweep/results/

# ---- Prisma ----
apps/api/prisma/migrations/**/*.sql.bak
apps/api/prisma/.env
apps/api/generated/
**/generated/prisma/
packages/db/generated/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env.python
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
*.egg-info/
.eggs/
htmlcov/
.coverage
.coverage.*

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Docker / local data ----
docker-compose.override.yml
.docker-data/

# ---- Editors / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.DS_Store
Thumbs.db
*.swp

# ---- Media fixtures too large for git ----
fixtures/large/

# Reproducible local video/font extraction output.
scratch/all_frames/
scratch/video_frames/
# Service restart stderr, beside the *.log files the same restarts write.
*.err

scratch/extracted_fonts/

# ---- Fonts pack build cache (A18b) ----
packages/fonts/.cache/

# B11: eval runner output (regenerated by pnpm --filter @montaj/prompts eval)
packages/prompts/eval-results/

# D08: eval harness nightly output (regenerated by pnpm --filter @montaj/worker-ai eval)
apps/worker-ai/eval-results/

# C00: release pipeline scratch output (build artifacts, notarization ledger, publish dirs)
.release/

# C02/C02c: electron-builder's own --dir output (pack:dry), never committed
apps/desktop/release/

# Regenerable QA artefacts, not source (2026-09-15). The repository tracks the
# reference trees and the deployment records in `scratch/`, but not the frame
# dumps and extracted font binaries those QA passes produced - 88 MB that any
# re-run recreates, and that no build reads.
scratch/extracted_fonts/
scratch/all_frames/
apps/web/test-results-wave0/
# `e2e/nocturne-shots.spec.ts` writes here: a look at the rebuilt screens,
# regenerated on demand and not something to keep in the history.
apps/web/test-results-nocturne/
