{
  "id": "ai.aksharo.panel",
  "name": "Aksharo Panel",
  "version": "0.1.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [
    {
      "app": "PPRO",
      "minVersion": "25.6"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "aksharo.panel.main",
      "label": {
        "default": "Aksharo"
      },
      "minimumSize": {
        "width": 360,
        "height": 480
      },
      "maximumSize": {
        "width": 480,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 600
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.aksharo.ai",
        "https://aksharo.ai",
        "https://127.0.0.1:47831",
        "https://127.0.0.1:47832",
        "https://127.0.0.1:47833",
        "https://localhost:47831",
        "https://localhost:47832",
        "https://localhost:47833"
      ]
    },
    "clipboard": "none",
    "launchProcess": {
      "schemes": []
    },
    "allowCodeGenerationFromStrings": false,
    "enableAddon": false
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.png"
    }
  ]
}
