{
  "name": "@montaj/premiere-uxp",
  "version": "0.1.0",
  "private": true,
  "description": "Aksharo Panel UXP plugin foundation for Adobe Premiere Pro: bridge sign-in, sequence/in-out read, audio mixdown + transcribe, panel UI, version banner.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:mogrt-placeholder": "tsx mogrt/build-placeholder.ts",
    "generate:style-coverage": "tsx src/styles/generate-coverage.ts",
    "verify:mogrt": "tsx mogrt/verify-cli.ts"
  },
  "dependencies": {
    "@montaj/caption-styles": "workspace:*",
    "@montaj/config": "workspace:*",
    "@montaj/shared-apply": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ulid": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
