{
  "name": "@montaj/ae-cep",
  "version": "0.1.0",
  "private": true,
  "description": "Aksharo Panel CEP 12 plugin for Adobe After Effects: bridge sign-in, WAV mixdown, styled text layers, alpha overlay import, one undo group per apply.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:jsx": "eslint --config eslint.extendscript.mjs src/jsx",
    "test": "vitest run --maxWorkers=2",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:style-coverage": "tsx src/styles/generate-coverage.ts"
  },
  "dependencies": {
    "@montaj/caption-styles": "workspace:*",
    "@montaj/config": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ulid": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
