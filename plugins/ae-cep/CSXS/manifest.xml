<?xml version="1.0" encoding="UTF-8"?>
<!--
  CEP 12 extension manifest. Reference: Adobe CEP "Extension manifest.xml"
  (https://github.com/Adobe-CEP/CEP-Resources/blob/master/CEP_12.x/CEP%2012%20HTML%20Extension%20Cookbook.md#extension-manifest)
  and the CEP-Resources sample manifests (same repo, `Samples/*/CSXS/manifest.xml`) for the
  exact element set below. `ExtensionBundleId` is `ai.aksharo.ae` (`PLUGIN_IDS.afterEffectsCep`,
  `@montaj/config/brand`) — see that file's header: `montaj` (the engineering codename) must
  never appear in a bundle id.

  Host min version: RR-07 / `03-architecture/12-redesign-decisions.md` D19 ("After Effects is
  CEP-only ... fast-follow after Premiere") does not pin an exact AE version; this manifest
  targets AE 24.0 (2024, the first version documented as shipping CEP 12 hosts per Adobe's CEP
  12 release notes) as the floor — same-era choice as Premiere's UXP `minVersion 25.6` in
  `plugins/premiere-uxp/manifest.json`. Confirm/adjust at Gate C once a human runs this against
  a real AE install (`docs/GATE-C-CHECKLIST.md`).
-->
<ExtensionManifest Version="10.0" ExtensionBundleId="ai.aksharo.ae" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Aksharo Panel">
  <ExtensionList>
    <Extension Id="ai.aksharo.ae.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="ai.aksharo.ae.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./src/jsx/aksharo.jsx</ScriptPath>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Aksharo</Menu>
          <Geometry>
            <Size>
              <Height>600</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>480</Height>
              <Width>320</Width>
            </MinSize>
            <MaxSize>
              <Height>2000</Height>
              <Width>480</Width>
            </MaxSize>
          </Geometry>
          <!-- No <Icons> block: this WP never commits binary assets (rule from the brief).
               C10 (installer/Marketplace listing) is responsible for adding real PNGs and the
               matching <Icons> entries before a real package ships. -->
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
