<?xml version="1.0" encoding="UTF-8"?>
<!--
  DaVinci Resolve Studio Workflow Integration plugin manifest.

  UNCONFIRMED SCHEMA: this repo has no DaVinci Resolve install and human spike A00-04
  (docs/PLAN.md) has not reported, so the exact Workflow Integration manifest schema
  Blackmagic's Resolve Studio expects is not verified here — no other file in this repo
  documents it either. This file follows the shape Blackmagic's own "DaVinci Resolve
  Workflow Integrations" developer material describes at a high level (a manifest naming a
  panel view backed by an HTML/JS bundle, registered under a Resolve-assigned "Workflow
  Integration Plugins" folder distinct from the Fusion `Scripts/Utility` path C08's script
  installs to) rather than any doc found in this repository. Do not ship this unmodified
  before a Gate C run against a real Resolve Studio install confirms/corrects it
  (docs/GATE-C-CHECKLIST.md "Studio panel" section, added by this work package).
-->
<Plugin>
  <UUID>ai.aksharo.resolve-panel</UUID>
  <Name>Aksharo</Name>
  <Version>0.1.0</Version>
  <VendorName>Aksharo</VendorName>
  <!-- D65 non-affiliation: this manifest names the compatible host as a compatibility
       statement only, never inside the product name itself. -->
  <Description>Aksharo — works with DaVinci Resolve. Not made, endorsed, or supported by Blackmagic Design.</Description>
  <MinimumHostVersion>18.5</MinimumHostVersion>
  <RequiresStudio>true</RequiresStudio>
  <Views>
    <View>
      <Id>ai.aksharo.resolve-panel.main</Id>
      <Label>Aksharo</Label>
      <SourceFile>index.html</SourceFile>
      <DefaultWidth>380</DefaultWidth>
      <DefaultHeight>600</DefaultHeight>
    </View>
  </Views>
</Plugin>
